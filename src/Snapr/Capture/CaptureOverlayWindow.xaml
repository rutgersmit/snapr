<Window x:Class="Snapr.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Snapr.Localization"
        Title="Snapr capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross">
    <Grid x:Name="Root">
        <Image x:Name="Screenshot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Canvas x:Name="Layer" IsHitTestVisible="False">
            <Path x:Name="Dim" Fill="#73000000">
                <Path.Data>
                    <GeometryGroup FillRule="EvenOdd">
                        <RectangleGeometry x:Name="DimFull" />
                        <RectangleGeometry x:Name="DimHole" />
                    </GeometryGroup>
                </Path.Data>
            </Path>
            <Line x:Name="CrossH" Stroke="#B0FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" />
            <Line x:Name="CrossV" Stroke="#B0FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" />
            <Rectangle x:Name="SelectionBorder" Stroke="White" StrokeThickness="1" Visibility="Collapsed" />
            <Border x:Name="SizeLabel" Background="#E62C2C2E" CornerRadius="5" Padding="7,3" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
            </Border>
            <Border x:Name="Hint" Background="#E62C2C2E" CornerRadius="8" Padding="12,7">
                <TextBlock Foreground="#F2F2F7" FontSize="13" FontFamily="Segoe UI"
                           Text="{x:Static loc:Strings.CaptureHint}" />
            </Border>
        </Canvas>
    </Grid>
</Window>
