<Window x:Class="Snapr.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Snapr.Localization"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Icon="/Assets/snapr.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="{x:Static loc:Strings.Shortcut}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                    Content="PrintScreen" Click="OnResetHotkey" />
            <TextBox x:Name="HotkeyBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Arrow"
                     IsReadOnlyCaretVisible="False"
                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"
                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
        </DockPanel>
        <TextBlock Foreground="{StaticResource SubtleForeground}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{x:Static loc:Strings.ShortcutHelp}" />

        <TextBlock Text="{x:Static loc:Strings.SaveFolder}" FontWeight="SemiBold" Margin="0,18,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                    Content="{x:Static loc:Strings.Browse}" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" Style="{StaticResource DarkTextBox}" />
        </DockPanel>

        <CheckBox x:Name="CopyOnCaptureBox" Margin="0,18,0,0" Foreground="{StaticResource ForegroundBrush}"
                  Content="{x:Static loc:Strings.CopyOnCapture}" />
        <CheckBox x:Name="StartupBox" Margin="0,8,0,0" Foreground="{StaticResource ForegroundBrush}"
                  Content="{x:Static loc:Strings.StartWithWindows}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Click="OnCancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.SaveButton}" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
